{
  "expo": {
    "name": "LinguaViva",
    "slug": "linguaviva",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "linguaviva",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#6D28D9",
      "resizeMode": "contain"
    },
    "ios": { "supportsTablet": true },
    "android": {
      "adaptiveIcon": { "backgroundColor": "#6D28D9" },
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "apiBaseUrl": "https://api.linguaviva.local",
      "useMockApi": true
    }
  }
}
